# Copy to .env (or set these as environment variables in TrueNAS).

# Strongly recommended if the app is reachable from the internet
APP_USER=admin
APP_PASSWORD=change-me

# Optional: adds Google Hotels via SerpApi (more sites and more reviews).
# Super.com, Booking.com and Tripadvisor work without any key.
SERPAPI_KEY=

# Optional tuning
# SOURCES=super,booking,tripadvisor,google   # turn individual sites off
# CURRENCY=USD             # Booking.com/Google only; Super.com and Tripadvisor quote USD
# DEMO_MODE=true           # made-up data, no network (for trying the app out)
# SEARCH_CACHE_HOURS=6     # re-use search results this long (be gentle on the sites)
# REVIEW_CACHE_DAYS=14     # re-use pool-heat review checks this long
# WATCH_INTERVAL_HOURS=12  # how often watched stays are re-priced
# PORT=3000
# DATA_DIR=/data

# Only for docker-compose.yml (Caddy on a VPS)
# DOMAIN=hotels.example.com
