# Your domain (point its DNS A record at this server first), e.g. hotels.example.com
DOMAIN=hotels.example.com

# Live prices: free key at https://serpapi.com (leave empty for demo mode)
SERPAPI_KEY=

# Strongly recommended on a public domain, otherwise anyone can use up your API credits
APP_USER=admin
APP_PASSWORD=change-me

# Optional tuning
# SEARCH_CACHE_HOURS=6      # re-use search results this long (saves API credits)
# REVIEW_CACHE_DAYS=14      # re-use review analysis this long
# SEARCH_PAGES=2            # result pages per search (~20 hotels each, 1 credit each)
# REVIEW_PAGES=2            # review pages read per heat check (1 credit each)
# WATCH_INTERVAL_HOURS=12   # how often watched stays are re-priced
# SERPAPI_GL=us             # country Google Hotels searches from
